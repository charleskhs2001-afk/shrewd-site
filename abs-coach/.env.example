# Copy to .env for local use. All optional.
# Switches on photo analysis by Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for analysis (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Caps to keep your API bill predictable
ANALYSES_PER_HOUR=12
ANALYSES_PER_DAY=300
PORT=3000
